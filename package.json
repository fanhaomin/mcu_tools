{
  "name": "auto-cmake-flash",
  "displayName": "Auto CMake Flash (STM32)",
  "description": "STM32 \u5de5\u7a0b\u81ea\u52a8\u8bc6\u522b\u3001CMake \u914d\u7f6e\u7f16\u8bd1\u3001ST-LINK \u70e7\u5f55\u4e0e\u6821\u9a8c\u4e00\u4f53\u5316\u5de5\u5177\uff08\u7b2c\u4e00\u7248\u4ec5\u652f\u6301 STM32\uff09",
  "version": "0.9.18",
  "publisher": "acflash",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Embedded"
  ],
  "keywords": [
    "STM32",
    "CMake",
    "ST-LINK",
    "embedded",
    "STM32CubeCLT"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "auto-cmake-flash",
          "title": "Auto CMake Flash",
          "icon": "resources/auto-cmake-flash.svg"
        }
      ]
    },
    "views": {
      "auto-cmake-flash": [
        {
          "id": "autoCmakeFlash.project",
          "name": "\u5de5\u7a0b\u4e0e\u73af\u5883"
        }
      ],
      "auto-cmake-flash-debug": [
        {
          "id": "autoCmakeFlash.periph",
          "name": "\u5916\u8bbe\u5bc4\u5b58\u5668",
          "type": "webview"
        },
        {
          "id": "autoCmakeFlash.watch",
          "name": "\u53d8\u91cf\u76d1\u63a7",
          "type": "webview"
        },
        {
          "id": "autoCmakeFlash.memview",
          "name": "\u5185\u5b58\u89c6\u56fe",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "autoCmakeFlash.iocLauncher",
        "displayName": "STM32CubeMX (Auto CMake Flash)",
        "selector": [
          {
            "filenamePattern": "*.ioc"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "autoCmakeFlash.chooseProject",
        "title": "Auto CMake Flash: \u9009\u62e9\u8981\u7f16\u8bd1/\u70e7\u5f55\u7684\u5de5\u7a0b",
        "icon": "$(folder)"
      },
      {
        "command": "autoCmakeFlash.scanProject",
        "title": "Auto CMake Flash: \u626b\u63cf\u5de5\u7a0b\u4e0e\u73af\u5883",
        "icon": "$(refresh)"
      },
      {
        "command": "autoCmakeFlash.detectEnvironment",
        "title": "Auto CMake Flash: \u68c0\u6d4b\u5f00\u53d1\u73af\u5883",
        "icon": "$(tools)"
      },
      {
        "command": "autoCmakeFlash.detectStLink",
        "title": "Auto CMake Flash: \u68c0\u6d4b ST-LINK \u8fde\u63a5",
        "icon": "$(plug)"
      },
      {
        "command": "autoCmakeFlash.configureCMake",
        "title": "Auto CMake Flash: \u914d\u7f6e CMake",
        "icon": "$(settings-gear)"
      },
      {
        "command": "autoCmakeFlash.build",
        "title": "Auto CMake Flash: \u7f16\u8bd1\u5de5\u7a0b",
        "icon": "$(zap)"
      },
      {
        "command": "autoCmakeFlash.rebuild",
        "title": "Auto CMake Flash: \u91cd\u65b0\u914d\u7f6e\u5e76\u7f16\u8bd1",
        "icon": "$(debug-restart)"
      },
      {
        "command": "autoCmakeFlash.buildAndFlash",
        "title": "Auto CMake Flash: \u7f16\u8bd1\u5e76\u70e7\u5f55",
        "icon": "$(rocket)"
      },
      {
        "command": "autoCmakeFlash.debug",
        "title": "Auto CMake Flash: \u7f16\u8bd1\u5e76\u8c03\u8bd5",
        "icon": "$(debug-alt)"
      },
      {
        "command": "autoCmakeFlash.debugAttach",
        "title": "Auto CMake Flash: \u9644\u52a0\u8c03\u8bd5\u8fd0\u884c\u4e2d\u7684\u76ee\u6807",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "autoCmakeFlash.openIoc",
        "title": "Auto CMake Flash: \u5728 STM32CubeMX \u4e2d\u6253\u5f00 .ioc",
        "icon": "$(file-text)"
      },
      {
        "command": "autoCmakeFlash.flashExisting",
        "title": "Auto CMake Flash: \u70e7\u5f55\u73b0\u6709\u56fa\u4ef6",
        "icon": "$(rocket)"
      },
      {
        "command": "autoCmakeFlash.clean",
        "title": "Auto CMake Flash: \u6e05\u7406\u63d2\u4ef6\u6784\u5efa\u76ee\u5f55",
        "icon": "$(trash)"
      },
      {
        "command": "autoCmakeFlash.openBuildDir",
        "title": "Auto CMake Flash: \u6253\u5f00\u6784\u5efa\u76ee\u5f55",
        "icon": "$(folder-opened)"
      },
      {
        "command": "autoCmakeFlash.showArtifacts",
        "title": "Auto CMake Flash: \u663e\u793a\u6784\u5efa\u4ea7\u7269\u4fe1\u606f",
        "icon": "$(file-binary)"
      },
      {
        "command": "autoCmakeFlash.revealElf",
        "title": "Auto CMake Flash: \u5b9a\u4f4d ELF \u6587\u4ef6",
        "icon": "$(search)"
      },
      {
        "command": "autoCmakeFlash.chooseMcu",
        "title": "Auto CMake Flash: \u624b\u52a8\u9009\u62e9\u82af\u7247\u578b\u53f7",
        "icon": "$(chip)"
      },
      {
        "command": "autoCmakeFlash.showLogs",
        "title": "Auto CMake Flash: \u67e5\u770b\u65e5\u5fd7",
        "icon": "$(output)"
      },
      {
        "command": "autoCmakeFlash.openSettings",
        "title": "Auto CMake Flash: \u6253\u5f00\u8bbe\u7f6e",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "autoCmakeFlash.openIoc",
          "when": "resourceExtname == .ioc",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "autoCmakeFlash.build",
          "group": "navigation@1",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.buildAndFlash",
          "group": "navigation@2",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.debug",
          "group": "navigation@3",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.scanProject",
          "group": "navigation@4",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.showLogs",
          "group": "overflow@1",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.openSettings",
          "group": "overflow@2",
          "when": "view == autoCmakeFlash.project"
        }
      ],
      "commandPalette": [
        {
          "command": "autoCmakeFlash.scanProject"
        },
        {
          "command": "autoCmakeFlash.detectEnvironment"
        },
        {
          "command": "autoCmakeFlash.detectStLink"
        },
        {
          "command": "autoCmakeFlash.configureCMake"
        },
        {
          "command": "autoCmakeFlash.build"
        },
        {
          "command": "autoCmakeFlash.rebuild"
        },
        {
          "command": "autoCmakeFlash.buildAndFlash"
        },
        {
          "command": "autoCmakeFlash.debug"
        },
        {
          "command": "autoCmakeFlash.debugAttach"
        },
        {
          "command": "autoCmakeFlash.openIoc"
        },
        {
          "command": "autoCmakeFlash.flashExisting"
        },
        {
          "command": "autoCmakeFlash.clean"
        },
        {
          "command": "autoCmakeFlash.openBuildDir"
        },
        {
          "command": "autoCmakeFlash.showArtifacts"
        },
        {
          "command": "autoCmakeFlash.revealElf"
        },
        {
          "command": "autoCmakeFlash.chooseMcu"
        },
        {
          "command": "autoCmakeFlash.showLogs"
        },
        {
          "command": "autoCmakeFlash.openSettings"
        }
      ]
    },
    "panels": {
      "acf-debug": {
        "id": "auto-cmake-flash-debug",
        "title": "ACF \u8c03\u8bd5",
        "icon": "resources/auto-cmake-flash.svg"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo skip: out prebuilt",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "__metadata": {
    "installedTimestamp": 1792759059103,
    "targetPlatform": "undefined",
    "size": 217738
  }
}
