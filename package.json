{
  "name": "auto-cmake-flash",
  "displayName": "Embedded Debug (STM32)",
  "description": "STM32 一体化插件：工程识别 · CMake 编译 · ST-LINK 烧录 · 在线调试 · 实时监控",
  "version": "0.9.125",
  "publisher": "acflash",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Embedded"
  ],
  "keywords": [
    "STM32",
    "CMake",
    "ST-LINK",
    "embedded",
    "STM32CubeCLT"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "auto-cmake-flash",
          "title": "Embedded Debug",
          "icon": "resources/auto-cmake-flash.png"
        }
      ],
      "panel": [
        {
          "id": "ed-debug-panel",
          "title": "调试器",
          "icon": "resources/auto-cmake-flash.png"
        }
      ]
    },
    "views": {
      "auto-cmake-flash": [
        {
          "id": "autoCmakeFlash.project",
          "name": "工程与环境"
        }
      ],
      "ed-debug-panel": [
        {
          "id": "autoCmakeFlash.periph",
          "name": "外设寄存器",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.watch",
          "name": "变量监控",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.chart",
          "name": "波形",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.arrayview",
          "name": "数组",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.memview",
          "name": "内存视图",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.callstack",
          "name": "调用栈",
          "type": "webview",
          "when": "acf.debugActive"
        },
        {
          "id": "autoCmakeFlash.disasm",
          "name": "反汇编",
          "type": "webview",
          "when": "acf.debugActive"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "autoCmakeFlash.iocLauncher",
        "displayName": "STM32CubeMX (Embedded Debug)",
        "selector": [
          {
            "filenamePattern": "*.ioc"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "autoCmakeFlash.showDisasmHere",
        "title": "Embedded Debug: 在反汇编中显示此行",
        "icon": "$(list-tree)"
      },
      {
        "command": "autoCmakeFlash.chooseProject",
        "title": "Embedded Debug: 选择要编译/烧录的工程",
        "icon": "$(folder)"
      },
      {
        "command": "autoCmakeFlash.scanProject",
        "title": "Embedded Debug: 扫描工程与环境",
        "icon": "$(refresh)"
      },
      {
        "command": "autoCmakeFlash.detectEnvironment",
        "title": "Embedded Debug: 检测开发环境",
        "icon": "$(tools)"
      },
      {
        "command": "autoCmakeFlash.detectStLink",
        "title": "Embedded Debug: 检测 ST-LINK 连接",
        "icon": "$(plug)"
      },
      {
        "command": "autoCmakeFlash.configureCMake",
        "title": "Embedded Debug: 配置 CMake",
        "icon": "$(settings-gear)"
      },
      {
        "command": "autoCmakeFlash.build",
        "title": "Embedded Debug: 编译工程",
        "icon": "$(zap)"
      },
      {
        "command": "autoCmakeFlash.rebuild",
        "title": "Embedded Debug: 重新配置并编译",
        "icon": "$(debug-restart)"
      },
      {
        "command": "autoCmakeFlash.buildAndFlash",
        "title": "Embedded Debug: 编译并烧录",
        "icon": "$(rocket)"
      },
      {
        "command": "autoCmakeFlash.debug",
        "title": "Embedded Debug: 编译并调试",
        "icon": "$(debug-alt)"
      },
      {
        "command": "autoCmakeFlash.debugAttach",
        "title": "Embedded Debug: 附加调试运行中的目标",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "autoCmakeFlash.openIoc",
        "title": "Embedded Debug: 在 STM32CubeMX 中打开 .ioc",
        "icon": "$(file-text)"
      },
      {
        "command": "autoCmakeFlash.flashExisting",
        "title": "Embedded Debug: 烧录现有固件",
        "icon": "$(rocket)"
      },
      {
        "command": "autoCmakeFlash.clean",
        "title": "Embedded Debug: 清理插件构建目录",
        "icon": "$(trash)"
      },
      {
        "command": "autoCmakeFlash.openBuildDir",
        "title": "Embedded Debug: 打开构建目录",
        "icon": "$(folder-opened)"
      },
      {
        "command": "autoCmakeFlash.showArtifacts",
        "title": "Embedded Debug: 显示构建产物信息",
        "icon": "$(file-binary)"
      },
      {
        "command": "autoCmakeFlash.revealElf",
        "title": "Embedded Debug: 定位 ELF 文件",
        "icon": "$(search)"
      },
      {
        "command": "autoCmakeFlash.chooseMcu",
        "title": "Embedded Debug: 手动选择芯片型号",
        "icon": "$(chip)"
      },
      {
        "command": "autoCmakeFlash.showLogs",
        "title": "Embedded Debug: 查看日志",
        "icon": "$(output)"
      },
      {
        "command": "autoCmakeFlash.openSettings",
        "title": "Embedded Debug: 打开设置",
        "icon": "$(gear)"
      },
      {
        "command": "autoCmakeFlash.addWatchFromEditor",
        "title": "Embedded Debug: 添加到变量监控",
        "icon": "$(add)"
      },
      {
        "command": "autoCmakeFlash.browseWatchVars",
        "title": "Embedded Debug: 浏览 ELF 变量并添加监控",
        "icon": "$(symbol-variable)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "autoCmakeFlash.openIoc",
          "when": "resourceExtname == .ioc",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "autoCmakeFlash.showDisasmHere",
          "when": "editorTextFocus",
          "group": "navigation@9"
        },
        {
          "command": "autoCmakeFlash.addWatchFromEditor",
          "when": "editorTextFocus",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "autoCmakeFlash.build",
          "group": "navigation@1",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.buildAndFlash",
          "group": "navigation@2",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.debug",
          "group": "navigation@3",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.scanProject",
          "group": "navigation@4",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.showLogs",
          "group": "overflow@1",
          "when": "view == autoCmakeFlash.project"
        },
        {
          "command": "autoCmakeFlash.openSettings",
          "group": "overflow@2",
          "when": "view == autoCmakeFlash.project"
        }
      ],
      "commandPalette": [
        {
          "command": "autoCmakeFlash.scanProject"
        },
        {
          "command": "autoCmakeFlash.detectEnvironment"
        },
        {
          "command": "autoCmakeFlash.detectStLink"
        },
        {
          "command": "autoCmakeFlash.configureCMake"
        },
        {
          "command": "autoCmakeFlash.build"
        },
        {
          "command": "autoCmakeFlash.rebuild"
        },
        {
          "command": "autoCmakeFlash.buildAndFlash"
        },
        {
          "command": "autoCmakeFlash.debug"
        },
        {
          "command": "autoCmakeFlash.debugAttach"
        },
        {
          "command": "autoCmakeFlash.openIoc"
        },
        {
          "command": "autoCmakeFlash.flashExisting"
        },
        {
          "command": "autoCmakeFlash.clean"
        },
        {
          "command": "autoCmakeFlash.openBuildDir"
        },
        {
          "command": "autoCmakeFlash.showArtifacts"
        },
        {
          "command": "autoCmakeFlash.revealElf"
        },
        {
          "command": "autoCmakeFlash.chooseMcu"
        },
        {
          "command": "autoCmakeFlash.showLogs"
        },
        {
          "command": "autoCmakeFlash.openSettings"
        },
        {
          "command": "autoCmakeFlash.addWatchFromEditor"
        },
        {
          "command": "autoCmakeFlash.browseWatchVars"
        }
      ]
    },
    "configuration": {
      "title": "Embedded Debug",
      "properties": {
        "autoCmakeFlash.buildType": {
          "type": "string",
          "scope": "resource",
          "default": "Debug",
          "enum": [
            "Debug",
            "Release",
            "RelWithDebInfo",
            "MinSizeRel"
          ],
          "description": "构建类型（产物目录与调试信息量）"
        },
        "autoCmakeFlash.cmakeToolchainFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "CMake 工具链文件；留空自动识别工程内 cmake/*.cmake"
        },
        "autoCmakeFlash.cmakeExtraArgs": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "CMake 配置额外参数（空格分隔）"
        },
        "autoCmakeFlash.downloadInterface": {
          "type": "string",
          "scope": "resource",
          "default": "SWD",
          "enum": [
            "SWD",
            "JTAG"
          ],
          "description": "烧录/调试接口"
        },
        "autoCmakeFlash.downloadSpeedKhz": {
          "type": "number",
          "scope": "resource",
          "default": 4000,
          "description": "连接速度 kHz（100-24000）"
        },
        "autoCmakeFlash.resetAfterFlash": {
          "type": "string",
          "scope": "resource",
          "default": "hardware",
          "enum": [
            "hardware",
            "software",
            "none"
          ],
          "description": "烧录后复位方式"
        },
        "autoCmakeFlash.binFlashAddress": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "BIN 烧录基地址（如 0x08010000；烧 ELF/HEX 留空）"
        },
        "autoCmakeFlash.probeRsChip": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "probe-rs 芯片名（如 STM32F103C8）；留空自动推导"
        },
        "autoCmakeFlash.svdFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "SVD 文件路径；留空按芯片型号定位"
        },
        "autoCmakeFlash.cmakePath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "CMake 路径；留空自动探测"
        },
        "autoCmakeFlash.ninjaPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Ninja 路径；留空自动探测"
        },
        "autoCmakeFlash.armToolchainPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "ARM 工具链 bin 目录或 gcc 完整路径；留空自动探测"
        },
        "autoCmakeFlash.programmerCliPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "STM32CubeProgrammer CLI 路径；留空自动探测"
        },
        "autoCmakeFlash.cubemxPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "STM32CubeMX.exe 路径；留空自动探测"
        },
        "autoCmakeFlash.verboseLogging": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "输出详细日志"
        },
        "autoCmakeFlash.buildTimeoutSec": {
          "type": "number",
          "scope": "resource",
          "default": 600,
          "description": "编译超时（秒）"
        },
        "autoCmakeFlash.flashTimeoutSec": {
          "type": "number",
          "scope": "resource",
          "default": 300,
          "description": "烧录超时（秒）"
        },
        "autoCmakeFlash.debugRefreshMs": {
          "type": "number",
          "scope": "resource",
          "default": 200,
          "description": "调试面板刷新间隔 ms（50-5000）"
        },
        "autoCmakeFlash.buildDir": {
          "type": "string",
          "scope": "resource",
          "default": "build/${buildType}",
          "description": "构建目录；默认 build/Debug 按构建类型分文件夹"
        },
        "autoCmakeFlash.generator": {
          "type": "string",
          "scope": "resource",
          "default": "Ninja",
          "description": "CMake 生成器（一般保持 Ninja）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo skip: out prebuilt",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "__metadata": {
    "installedTimestamp": 1792759059103,
    "targetPlatform": "undefined",
    "size": 217738
  },
  "icon": "resources/auto-cmake-flash.png"
}
